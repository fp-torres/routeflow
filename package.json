{
  "name": "routeflow",
  "version": "1.0.0",
  "private": true,
  "description": "RouteFlow — Gestão inteligente de operações em campo.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/fp-torres/routeflow.git"
  },
  "homepage": "https://routeflow.forgedevapps.com",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/config",
    "packages/types",
    "packages/ui",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "postinstall": "npm run build:packages",
    "dev": "npm run build:packages && concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @routeflow/api\" \"npm run dev -w @routeflow/web\"",
    "dev:api": "npm run dev -w @routeflow/api",
    "dev:web": "npm run dev -w @routeflow/web",
    "build": "npm run db:generate && npm run build:packages && npm run build -w @routeflow/web && npm run build -w @routeflow/api",
    "build:packages": "npm run build -w @routeflow/types",
    "build:hostinger": "npm install --include=dev --no-audit --no-fund && npm run build",
    "start": "node apps/api/dist/main.js",
    "start:prod": "node apps/api/dist/main.js",
    "test": "npm run build:packages && npm run test -w @routeflow/types && npm run test -w @routeflow/ui && npm run test -w @routeflow/web && npm run test -w @routeflow/api",
    "test:unit": "npm run build:packages && npm run test -w @routeflow/types && npm run test -w @routeflow/ui && npm run test -w @routeflow/web && npm run test:unit -w @routeflow/api",
    "test:e2e": "npm run build:packages && npm run test:e2e -w @routeflow/api",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @routeflow/types && npm run typecheck -w @routeflow/ui && npm run typecheck -w @routeflow/web && npm run typecheck -w @routeflow/api",
    "db:generate": "npm run db:generate:postgres && npm run db:generate:mysql",
    "db:generate:postgres": "node scripts/db.mjs generate postgresql",
    "db:generate:mysql": "node scripts/db.mjs generate mysql",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:migrate:postgres": "node scripts/db.mjs migrate postgresql",
    "db:migrate:mysql": "node scripts/db.mjs migrate mysql",
    "db:migrate:dev:postgres": "node scripts/db.mjs migrate-dev postgresql",
    "db:migrate:dev:mysql": "node scripts/db.mjs migrate-dev mysql",
    "db:deploy": "node scripts/db.mjs deploy",
    "db:deploy:postgres": "node scripts/db.mjs deploy postgresql",
    "db:deploy:mysql": "node scripts/db.mjs deploy mysql",
    "db:status:postgres": "node scripts/db.mjs status postgresql",
    "db:status:mysql": "node scripts/db.mjs status mysql",
    "db:reset:postgres": "node scripts/db.mjs reset postgresql",
    "db:seed": "node scripts/db.mjs seed",
    "db:seed:postgres": "node scripts/db.mjs seed postgresql",
    "db:seed:mysql": "node scripts/db.mjs seed mysql",
    "db:studio": "node scripts/db.mjs studio",
    "db:check": "node scripts/check-prisma-schemas.mjs",
    "db:sync-schemas": "node scripts/check-prisma-schemas.mjs --write",
    "import:xlsx": "node scripts/db.mjs import",
    "geocode:stores": "node scripts/db.mjs geocode",
    "release:prepare": "node scripts/prepare-release.mjs",
    "docker:db": "docker compose up -d postgres",
    "docker:db:mysql": "docker compose --profile mysql up -d mariadb"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "concurrently": "^10.0.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
