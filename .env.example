# =====================================================================
# RouteFlow — variáveis de ambiente
# Copie para .env (desenvolvimento) e NUNCA versione o arquivo .env.
# Em produção (Hostinger), cadastre estas variáveis no painel hPanel.
# =====================================================================

# ---------- Ambiente ----------
# development | test | production
NODE_ENV=development
# Porta HTTP da API (a Hostinger injeta PORT automaticamente em produção)
PORT=3000
HOST=0.0.0.0
# URL pública da aplicação. Produção: https://routeflow.forgedevapps.com
APP_URL=http://localhost:5173
# Fuso horário de negócio (datas de visitas, "hoje", relatórios)
APP_TIMEZONE=America/Sao_Paulo
# true quando a aplicação roda atrás de proxy/HTTPS (Hostinger): habilita cookies "secure"
TRUST_PROXY=false
# Origens extras permitidas no CORS (separadas por vírgula). APP_URL já é incluída.
CORS_ORIGINS=http://localhost:5173

# ---------- Banco de dados ----------
# postgresql (desenvolvimento local) | mysql (produção: MySQL/MariaDB da Hostinger)
DATABASE_PROVIDER=postgresql
# Desenvolvimento (PostgreSQL via Docker):
DATABASE_URL=postgresql://routeflow:routeflow@localhost:5432/routeflow?schema=public
# Produção (exemplo — preencha com os dados do banco criado no hPanel):
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO
# Tamanho do pool de conexões (hospedagem compartilhada: mantenha baixo)
DB_POOL_SIZE=5
# Opcionais: URLs específicas usadas pelos scripts db:*:postgres / db:*:mysql
# DATABASE_URL_POSTGRESQL=postgresql://routeflow:routeflow@localhost:5432/routeflow?schema=public
# DATABASE_URL_MYSQL=mysql://routeflow:routeflow@localhost:3306/routeflow

# ---------- PostgreSQL local (docker compose) ----------
POSTGRES_USER=routeflow
POSTGRES_PASSWORD=routeflow
POSTGRES_DB=routeflow
POSTGRES_PORT=5432
# MariaDB local opcional (docker compose --profile mysql) para testar o banco de produção
MARIADB_ROOT_PASSWORD=routeflow-root
MARIADB_USER=routeflow
MARIADB_PASSWORD=routeflow
MARIADB_DATABASE=routeflow
MARIADB_PORT=3306

# ---------- Autenticação ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-com-48-bytes
# Duração do access token (ex.: 15m, 1h)
JWT_ACCESS_TTL=15m
# Duração do refresh token (dias)
REFRESH_TOKEN_TTL_DAYS=30
# Segredo para assinar URLs temporárias de fotos/PDFs (opcional; usa JWT_SECRET se vazio)
FILES_SIGNING_SECRET=

# ---------- Armazenamento de fotos e PDFs ----------
# local (disco do servidor) — preparado para s3/r2 no futuro
STORAGE_DRIVER=local
# Em produção use um caminho FORA da pasta da aplicação para não perder arquivos no deploy
# Ex.: /home/u123456789/routeflow-storage
STORAGE_PATH=./storage
MAX_PHOTO_SIZE_MB=15
MAX_PDF_SIZE_MB=10
MAX_SPREADSHEET_SIZE_MB=5
PHOTO_MAX_DIMENSION=2048
PHOTO_QUALITY=82
THUMBNAIL_SIZE=480

# ---------- Rotas, mapas e transporte ----------
# estimate = estimativa local (distância em linha reta + tarifas cadastradas)
# google   = Google Routes API (transporte público real; exige GOOGLE_MAPS_API_KEY)
ROUTE_PROVIDER=estimate
GOOGLE_MAPS_API_KEY=
# Geocodificação de endereços: none | nominatim (OpenStreetMap, gratuito, 1 req/s) | google
GEOCODING_PROVIDER=nominatim
# Área de busca (oeste,norte,leste,sul) — padrão: município do Rio de Janeiro
GEOCODING_VIEWBOX=-43.80,-22.74,-43.08,-23.09
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# E-mail de contato exigido pela política de uso do Nominatim
NOMINATIM_EMAIL=

# ---------- Seed / importação da planilha ----------
SEED_USER_NAME=Felipe
SEED_USER_EMAIL=felipe@routeflow.local
# Obrigatória em produção. Em desenvolvimento, se vazia, usa RouteFlow@2026 (troque após o 1º login)
SEED_USER_PASSWORD=
SEED_SPREADSHEET_PATH=data/Controle_Profissional_de_Visitas.xlsx

# ---------- Logs ----------
# error | warn | log | debug
LOG_LEVEL=log

# ---------- Proteção ----------
# Requisições por minuto por IP (rate limiting). Atrás de proxy, use TRUST_PROXY=true.
RATE_LIMIT_PER_MINUTE=600

# ---------- Deploy automático (Hostinger: sem terminal/hook de deploy) ----------
# true = aplica as migrations ao iniciar (a API não sobe se falharem)
MIGRATE_ON_START=false
# true = cria usuário inicial + configurações + importa a planilha (idempotente). Use no 1º deploy e desligue.
SEED_ON_START=false
