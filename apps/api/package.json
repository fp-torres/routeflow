{
  "name": "@routeflow/api",
  "version": "1.0.0",
  "private": true,
  "description": "API RouteFlow (NestJS + Prisma) — também serve o build do frontend em produção.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api -c gray,cyan \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"node --watch-path=dist --enable-source-maps dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:e2e": "jest --runInBand --forceExit --selectProjects e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@routeflow/types": "*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "concurrently": "^10.0.5",
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  }
}
